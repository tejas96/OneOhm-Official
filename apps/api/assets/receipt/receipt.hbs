<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <title>Receipt {{number}}</title>
  </head>
  <body>
    <header class="q-head">
      <div class="q-brand">
        <img class="q-logo" src="{{logo}}" alt="{{company.brand}}" />
        <p><strong>{{company.name}}</strong></p>
        <p class="q-muted">{{company.address}}</p>
        <p class="q-muted">GSTIN {{company.gstin}} · {{company.email}}</p>
        <p class="q-muted">{{company.phones}}</p>
      </div>
      <div class="q-meta">
        <p class="q-overline">Payment receipt</p>
        <p class="q-number">{{number}}</p>
        <dl>
          <div class="q-row"><dt>Date</dt><dd>{{date}}</dd></div>
          <div class="q-row"><dt>Project</dt><dd>{{project.code}}</dd></div>
        </dl>
      </div>
    </header>
    <div class="q-rule"></div>
    {{#if cancelled}}<p class="r-cancelled">{{cancelled}}</p>{{/if}}

    <section class="q-parties">
      <div>
        <p class="q-overline">Received from</p>
        <p class="q-name">{{receivedFrom}}</p>
        {{#if onBehalfOf}}<p class="q-muted">On behalf of {{onBehalfOf}}</p>{{/if}}
        <p>{{customer.phone}}</p>
      </div>
      <div>
        <p class="q-overline">Site</p>
        <p>{{site}}</p>
      </div>
    </section>

    <section class="r-amount">
      <p class="q-overline">Amount received</p>
      <p class="r-figure">{{amount}}</p>
      <p class="r-words">{{amountInWords}}</p>
    </section>

    <section class="q-section q-keep">
      <dl class="q-totals r-details">
        <div class="q-row"><dt>Towards</dt><dd>{{towards}}</dd></div>
        <div class="q-row"><dt>Paid by</dt><dd>{{method}}{{#if reference}} · {{reference}}{{/if}}</dd></div>
        <div class="q-row"><dt>Total project price</dt><dd>{{totals.price}}</dd></div>
        <div class="q-row"><dt>Received to date, with this receipt</dt><dd>{{totals.received}}</dd></div>
        <div class="q-row q-grand"><dt>Balance on the project</dt><dd>{{totals.balance}}</dd></div>
      </dl>
    </section>
    {{#if subsidyNote}}<p class="q-note">{{subsidyNote}}</p>{{/if}}

    <section class="q-sign q-keep">
      <div>
        <p class="q-muted">For {{company.name}}</p>
        <img class="q-stamp" src="{{stamp}}" alt="Signature and seal" />
        <p class="q-name">{{#if company.signatory}}{{company.signatory}}, {{/if}}{{company.designation}}</p>
      </div>
      <div class="q-accept">
        <p class="q-muted">This receipt is generated by OneOhm and is valid with the seal above.</p>
      </div>
    </section>
  </body>
</html>
