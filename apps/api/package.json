{
  "name": "@oneohm/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS HTTP API: ts-rest controllers over the domain rules and the database.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/open-sans": "5.2.7",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@oneohm/api-contracts": "workspace:*",
    "@oneohm/database": "workspace:*",
    "@oneohm/domain": "workspace:*",
    "@oneohm/shared": "workspace:*",
    "@ts-rest/core": "3.52.1",
    "@ts-rest/nest": "3.52.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "handlebars": "4.7.8",
    "helmet": "8.3.0",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.56.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oneohm/tsconfig": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
