{
  "name": "@oneohm/field",
  "version": "0.1.0",
  "private": true,
  "description": "OneOhm Field: the mobile app for employees, I&C partner crews and resellers (Expo).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.config.json",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:web": "expo export --platform web --output-dir dist/web",
    "test": "vitest run --passWithNoTests src"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/geist-mono": "0.4.3",
    "@expo-google-fonts/newsreader": "0.4.1",
    "@expo/metro-runtime": "58.0.16",
    "@oneohm/api-contracts": "workspace:*",
    "@oneohm/design-system": "workspace:*",
    "@oneohm/domain": "workspace:*",
    "@oneohm/mobile-ui": "workspace:*",
    "@oneohm/shared": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "@ts-rest/core": "3.52.1",
    "expo": "58.0.22",
    "expo-constants": "58.0.14",
    "expo-device": "58.0.5",
    "expo-font": "58.0.11",
    "expo-haptics": "58.0.7",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.15",
    "expo-router": "58.0.29",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "lucide-react-native": "1.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oneohm/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
