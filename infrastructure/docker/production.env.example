# OneOhm production settings. Copy to /opt/oneohm/.env on the server (chmod 600).
# Never commit the filled-in copy. Generate passwords with: openssl rand -base64 32

# Public address (DNS A record → the VM's public IP). Caddy gets the TLS certificate.
ONEOHM_DOMAIN=app.example.com

# PostgreSQL (also holds Temporal's databases)
POSTGRES_USER=oneohm
POSTGRES_PASSWORD=
POSTGRES_DB=oneohm

# Object storage (RustFS, S3 API) for photos, documents and generated PDFs
STORAGE_BUCKET=oneohm-files
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Creates the private bucket on the API's first start (RustFS starts empty).
STORAGE_AUTO_CREATE_BUCKET=true

# First Super Admin, created once by the migrate job
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

BUSINESS_TIMEZONE=Asia/Kolkata

# Mobile sign-in codes (required in production)
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_LOGIN_TEMPLATE_ID=

# SMS for customers who are not on WhatsApp (WhatsApp is always tried first; a number
# WhatsApp rejects switches to SMS by itself). Keep "log" until the DLT template for
# ##message## is approved, then set msg91. See docs/DEPLOYMENT.md, section 5c.
SMS_DELIVERY=log
MSG91_SMS_TEMPLATE_ID=

# WhatsApp Cloud API. Keep WHATSAPP_DELIVERY=log until the message templates listed in
# docs/DEPLOYMENT.md are approved in WhatsApp Manager, then switch to live.
WHATSAPP_DELIVERY=log
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Webhook for customer messages (the assistant) and delivery receipts. In Meta's app
# settings point it at https://<ONEOHM_DOMAIN>/api/v1/webhooks/whatsapp, subscribe to
# "messages", use this verify token, and copy the app secret (it signs each post).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Only while the app secret is unknown: see docs/DEPLOYMENT.md, section 5 (Webhook).
WHATSAPP_WEBHOOK_PATH_KEY=
# The business WhatsApp number customers write to (E.164); read from Meta when empty.
WHATSAPP_BUSINESS_NUMBER=
# Do NOT set WHATSAPP_TEST_NUMBERS here: it is for laptop testing only.

# Public address of the API, used in payment and shared-file links.
API_PUBLIC_URL=https://app.example.com/api
# Signs the 72-hour links the WhatsApp assistant sends for quotations and receipts.
FILE_LINK_SECRET=
FILE_LINK_HOURS=72

# Push notifications for the mobile apps go through Expo (Firebase on Android, Apple on
# iOS). The Firebase service-account JSON is uploaded to EAS (eas credentials), not here.
# Keep "log" until the apps are built with EAS, then set live.
PUSH_DELIVERY=log
EXPO_ACCESS_TOKEN=

# Razorpay payment links. off hides them; live needs the three keys. Point the Razorpay
# webhook at https://<ONEOHM_DOMAIN>/api/v1/webhooks/razorpay with the events
# payment_link.paid, payment_link.partially_paid, payment_link.expired,
# payment_link.cancelled and settlement.processed. Never use "sandbox" here.
RAZORPAY_MODE=off
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_LINK_DAYS=30

# RazorpayX payouts to vendors and crews (see docs/DEPLOYMENT.md, section 5d). Keep off
# until the RazorpayX account is funded and tested; never "sandbox" here.
RAZORPAYX_MODE=off
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

INTEGRATION_ENCRYPTION_KEY=

# Google Maps. Use separate restricted keys; the shared one is only a fallback.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_ANDROID_KEY=
