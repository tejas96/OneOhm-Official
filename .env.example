# OneOhm — environment variables.
# Copy to .env for local development. Every value below works with `pnpm infra:up`.

NODE_ENV=development
WEB_BASE_URL=http://localhost:3200
API_BASE_URL=http://localhost:4200
BUSINESS_TIMEZONE=Asia/Kolkata

DATABASE_URL=postgres://oneohm:oneohm-local-only@127.0.0.1:5460/oneohm

# RustFS object storage (S3 API)
STORAGE_ENDPOINT=http://127.0.0.1:9120
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=oneohm-files
STORAGE_ACCESS_KEY=oneohm-local
STORAGE_SECRET_KEY=oneohm-local-secret

# Temporal
TEMPORAL_ADDRESS=127.0.0.1:7250
TEMPORAL_NAMESPACE=oneohm

# Where the Next.js server reaches the API (the browser only calls /api on the web origin).
API_INTERNAL_URL=http://127.0.0.1:4200

# WhatsApp webhook (customer messages to the assistant, and delivery receipts). Point
# Meta's webhook at <API_PUBLIC_URL>/v1/webhooks/whatsapp, subscribe to "messages",
# and use this verify token; the app secret checks each post's signature.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Signs the links the assistant sends for quotations, receipts and documents.
FILE_LINK_SECRET=
FILE_LINK_HOURS=72

# Background worker: WhatsApp stays in log mode (nothing is sent) unless set to live.
WHATSAPP_DELIVERY=log
WHATSAPP_TEMPLATE_LANGUAGE=en

# Phone alerts through Expo push (Firebase on Android, Apple on iOS). "log" sends nothing.
# EXPO_ACCESS_TOKEN is only needed when "enhanced push security" is on in Expo.
PUSH_DELIVERY=log
EXPO_ACCESS_TOKEN=
# App builds: the Expo project ID, and the path to google-services.json for Android push.
EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=

# Mobile sign-in codes. "local" sends no SMS: the code is OTP_DEVELOPMENT_CODE.
# Production uses msg91 (MSG91_AUTH_KEY, MSG91_SENDER_ID, MSG91_LOGIN_TEMPLATE_ID).
OTP_PROVIDER=local
OTP_DEVELOPMENT_CODE=123456

# PDFs. Path to Chrome or Chromium on this machine, for example on macOS:
# CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Online payment links. off: hidden. sandbox: a local test page records test payments
# (development only). live: Razorpay, with the three keys below (test or live keys).
# Point the Razorpay webhook at <API_PUBLIC_URL>/v1/webhooks/razorpay with the events
# payment_link.paid, payment_link.partially_paid, payment_link.expired,
# payment_link.cancelled and settlement.processed.
RAZORPAY_MODE=off
PAYMENT_LINK_DAYS=30
API_PUBLIC_URL=http://localhost:4200
# Keys come from Dashboard > Account & Settings > API Keys.
# Webhook secret comes from Dashboard > Webhooks (you choose it).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
