{
  "name": "@oneohm/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Pure business rules for OneOhm: roles and permissions, EPC stages, subsidy, pricing, task generation and payment milestones. No framework or database code.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oneohm/shared": "workspace:*"
  },
  "devDependencies": {
    "@oneohm/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
